{-# CHECKPOINTS ["answerdotai/ModernBERT-base", "jhu-clsp/ettin-encoder-17m", "jhu-clsp/ettin-encoder-32m", "jhu-clsp/ettin-encoder-68m", "jhu-clsp/ettin-encoder-150m", "jhu-clsp/ettin-encoder-400m", "jhu-clsp/ettin-encoder-1b"] #-}
{-# TASK "masked_lm" #-}

import Masking (Mask)
import ModernBertEncoder
import Config
import NN

VOCAB_SIZE <- Config.int @@vocab_size default=50368
DECODER_BIAS <- Config.bool @@decoder_bias default=true

-- Returns the MLM logits and the last hidden state (after model.final_norm).
modernbert :: TokenIds[B,S] -> ?Mask[B,S,S] -> (Tensor[B,S,V], Tensor[B,S,D])
modernbert input_ids attn_mask = do
  hidden <- ModernBertEncoder.encode input_ids attn_mask
  x <- ModernBertEncoder.prediction_head hidden
  logits <- NN.linear@decoder x dim=VOCAB_SIZE bias=DECODER_BIAS weight_path=@@model.embeddings.tok_embeddings.weight
  return logits, hidden
