{-# CHECKPOINTS ["jhu-clsp/ettin-decoder-17m", "jhu-clsp/ettin-decoder-32m", "jhu-clsp/ettin-decoder-68m", "jhu-clsp/ettin-decoder-150m", "jhu-clsp/ettin-decoder-400m", "jhu-clsp/ettin-decoder-1b"] #-}
{-# TASK "causal_lm" #-}

import Activations (gelu, gelu_pytorch_tanh)
import Attention (attention, merge_heads, reshape_heads)
import Masking (Mask, causal_mask, mask_for_input, mask_length_for_input)
import Math (mul)
import Positions (position_ids, rope_base_factors, rope_pair_base_factors)
import Cache
import Config
import List
import NN
import Tensor

-- HF ModernBertDecoderForCausalLM (model_type "modernbert-decoder"): ModernBERT layers with
-- separate q/k/v projections, causal attention, and a KV cache.
MODEL_DIM <- Config.int @@hidden_size default=768
VOCAB_SIZE <- Config.int @@vocab_size default=50368
NUM_LAYERS <- Config.int @@num_hidden_layers default=22
NUM_HEADS <- Config.int @@num_attention_heads default=12
FFN <- Config.int @@intermediate_size default=1152
EPS <- Config.float @@norm_eps default=1e-05
ATTN_BIAS <- Config.bool @@attention_bias default=false
MLP_BIAS <- Config.bool @@mlp_bias default=false
NORM_BIAS <- Config.bool @@norm_bias default=false
HEAD_BIAS <- Config.bool @@classifier_bias default=false
DECODER_BIAS <- Config.bool @@decoder_bias default=true
HIDDEN_ACT <- Config.str @@hidden_activation default="gelu"
HEAD_ACT <- Config.str @@classifier_activation default="gelu"
LAYER_TYPES <- Config.list @@layer_types default=[]
HAS_LAYER_TYPES <- Config.has_value @@layer_types
FULL_EVERY <- Config.int @@global_attn_every_n_layers default=3
LOCAL_ATTN <- Config.int @@local_attention default=128
LOCAL_WIN = LOCAL_ATTN / 2
MAX_POS <- Config.int @@max_position_embeddings default=8192
THETA_FULL <- Config.float @@'rope_parameters.full_attention.rope_theta' default=(Config.float @@global_rope_theta default=160000.0)
THETA_LOCAL <- Config.float @@'rope_parameters.sliding_attention.rope_theta' default=(Config.float @@local_rope_theta default=10000.0)

-- HF ACT2FN: "gelu" is the exact erf GELU; the tanh approximation goes by two names.
ettin_act :: Tensor[..S] -> String -> Tensor[..S]
ettin_act x name = ((name == "gelu_pytorch_tanh") or (name == "gelu_new")) ? (gelu_pytorch_tanh x) : (gelu x)

-- config.layer_types when present, else every global_attn_every_n_layers-th layer is full.
ettin_is_full :: Int -> Bool
ettin_is_full i = HAS_LAYER_TYPES ? ((List.index LAYER_TYPES i) != "sliding_attention") : ((FULL_EVERY <= 0) ? true : ((i % FULL_EVERY) == 0))

-- Full layers attend causally to every cached key. Sliding layers attend to the LOCAL_WIN keys
-- ending at the query (0 <= i - j < local_attention // 2, as HF's sliding_window_overlay), so
-- their cache keeps only the last LOCAL_WIN - 1 keys. pad_full / pad_local are the padding
-- mask over those keys (null: no padding).
ettin_decoder_layer :: Tensor[B,S,D] -> Int -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> ?Tensor[B,K] -> ?Tensor[B,L] -> ?CacheLayer[B,NUM_HEADS,P,MAX_POS,DH] -> (Tensor[B,S,D], ?CacheLayer[B,NUM_HEADS,K,MAX_POS,DH])
ettin_decoder_layer x i rope_sin_full rope_cos_full rope_sin_local rope_cos_local pad_full pad_local past_kv = do
  xn <- (i == 0) ? x : NN.layernorm@attn_norm x eps=EPS bias=NORM_BIAS
  a, new_kv <- scope@attn do
    q <- NN.linear@q_proj xn dim=MODEL_DIM bias=ATTN_BIAS
    k <- NN.linear@k_proj xn dim=MODEL_DIM bias=ATTN_BIAS
    v <- NN.linear@v_proj xn dim=MODEL_DIM bias=ATTN_BIAS
    q <- reshape_heads q heads=NUM_HEADS
    k <- reshape_heads k heads=NUM_HEADS
    v <- reshape_heads v heads=NUM_HEADS
    full <- ettin_is_full i
    rope_sin <- full ? rope_sin_full : rope_sin_local
    rope_cos <- full ? rope_cos_full : rope_cos_local
    q_rot, k_rot <- rope_pair_base_factors q k rope_sin rope_cos
    q <- Tensor.cast_like q_rot v
    k <- Tensor.cast_like k_rot v
    keep <- full ? null : (LOCAL_WIN - 1)
    k, v, new_kv <- Cache.update_keep past_kv k v keep=keep
    att <- full ? (attention q k v (causal_mask q k padding_mask=pad_full)) : (attention q k v (causal_mask q k padding_mask=pad_local window=LOCAL_WIN))
    a <- merge_heads att |> NN.linear@Wo dim=MODEL_DIM bias=ATTN_BIAS
    return a, new_kv
  x <- x + a
  xn <- NN.layernorm@mlp_norm x eps=EPS bias=NORM_BIAS
  m <- scope@mlp do
    wi <- NN.linear@Wi xn dim=2*FFN bias=MLP_BIAS
    u, g <- Tensor.chunk wi parts=2
    return ettin_act u HIDDEN_ACT |> mul g |> NN.linear@Wo dim=MODEL_DIM bias=MLP_BIAS
  return x + m, new_kv

-- Positions are arange(S) + past length, independent of padding, as in HF. The past length is
-- read from layer 0, which is a full-attention layer in every Ettin config.
-- logits_to_keep > 0 keeps only the last positions, like HF's argument; 0, null or more than S
-- keeps all.
ettin_decoder :: TokenIds[B,S] -> ?Mask[B,K,MAX_POS] -> ?Cache[B,NUM_HEADS,P,MAX_POS,DH] -> ?Bool -> ?Int -> (Tensor[B,T,V], ?Cache[B,NUM_HEADS,K,MAX_POS,DH])
ettin_decoder input_ids attn_mask past_kv use_cache logits_to_keep = do
  past_length <- Cache.past_length past_kv
  attn_mask <- mask_for_input input_ids attn_mask MAX_POS
  pos_ids <- position_ids input_ids past_length=past_length
  rope_sin_full, rope_cos_full <- rope_base_factors pos_ids (MODEL_DIM / NUM_HEADS) THETA_FULL
  rope_sin_local, rope_cos_local <- rope_base_factors pos_ids (MODEL_DIM / NUM_HEADS) THETA_LOCAL
  key_len <- mask_length_for_input input_ids attn_mask past_length
  local_past <- (past_length < (LOCAL_WIN - 1)) ? past_length : (LOCAL_WIN - 1)
  local_len <- local_past + S
  pad_local <- (attn_mask == null) ? null : (Tensor.slice attn_mask dim=1 start=(key_len - local_len) end=key_len)
  x <- NN.embedding@model.embeddings.tok_embeddings input_ids dim=MODEL_DIM
  x <- NN.layernorm@model.embeddings.norm x eps=EPS bias=NORM_BIAS
  work_kv <- Cache.prepare past_kv use_cache MAX_POS
  read_kv <- Cache.read past_kv work_kv
  x, work_kv <- for@model.layers i <- [0..NUM_LAYERS) carry (x, work_kv) do
    past_i <- Cache.index read_kv i
    x, new_i <- ettin_decoder_layer x i rope_sin_full rope_cos_full rope_sin_local rope_cos_local attn_mask pad_local past_i
    work_kv <- Cache.append work_kv new_i
    yield x, work_kv
  work_kv <- Cache.finish work_kv key_len
  new_kv <- use_cache ? work_kv : null
  x <- NN.layernorm@model.final_norm x eps=EPS bias=NORM_BIAS
  keep <- (logits_to_keep == null) ? S : (((logits_to_keep <= 0) or (logits_to_keep > S)) ? S : logits_to_keep)
  x <- Tensor.slice x dim=1 start=(S - keep) end=S
  x <- NN.linear@lm_head.dense x dim=MODEL_DIM bias=HEAD_BIAS
  x <- ettin_act x HEAD_ACT
  x <- NN.layernorm@lm_head.norm x eps=EPS bias=NORM_BIAS
  logits <- NN.linear@decoder x dim=VOCAB_SIZE bias=DECODER_BIAS weight_path=@@model.embeddings.tok_embeddings.weight
  return logits, new_kv
