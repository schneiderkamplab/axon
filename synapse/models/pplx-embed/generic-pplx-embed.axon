{-# CHECKPOINTS ["perplexity-ai/pplx-embed-v1-0.6b"] #-}

import Activations (silu)
import Attention (attention, merge_heads, reshape_heads)
import Masking (Mask, bidirectional_mask_for_input, mask_for_input)
import Math (div, mul)
import Positions (position_ids, rope_base_factors, rope_pair_base_factors)
import Config
import NN
import Tensor



-- perplexity-ai/pplx-embed-v1-0.6b: PPLXQwen3Model (stock Qwen3 with every
-- layer non-causal) used as a sentence embedding model. sentence-transformers
-- pipeline = Transformer -> Pooling(mean over attention_mask) -> optional
-- tanh/int8 or binary quantizer (post-processing, not part of the graph).
-- Same encoder block as generic-pplx-pii-masking.axon (kept as two files because
-- the configs differ in shape); this checkpoint stores the backbone
-- at the top level (embed_tokens.*, layers.N.*, norm.weight) in fp32 and the
-- config is flat (no "backbone" sub-dict).
MODEL_DIM <- ((Config.dim @@hidden_size default=1024) :: Dim)
NUM_LAYERS <- ((Config.dim @@num_hidden_layers default=28) :: Dim)
NUM_HEADS <- ((Config.dim @@num_attention_heads default=16) :: Dim)
KVH <- ((Config.dim @@num_key_value_heads default=8) :: Dim)
HEAD_DIM <- ((Config.dim @@head_dim default=128) :: Dim)
QD <- do
  return (NUM_HEADS * HEAD_DIM :: Dim)
KVD <- do
  return (KVH * HEAD_DIM :: Dim)
FFN <- ((Config.dim @@intermediate_size default=3072) :: Dim)
EPS <- (Config.float @@rms_norm_eps default=1e-06)
THETA <- (Config.float @'rope_parameters.rope_theta' default=1000000.0)

rms :: Path -> Tensor[B,S,D] -> Tensor[B,S,D]
rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true

head_rms :: Path -> Tensor[B,H,S,HD] -> Tensor[B,H,S,HD]
head_rms@path x = NN.rmsnorm@path x eps=EPS cast_float=true

pplx_block :: Tensor[B,S,D] -> Tensor[B,1,S,R] -> Tensor[B,1,S,R] -> Tensor[B,1,S,S] -> Tensor[B,S,D]
pplx_block x rope_sin rope_cos mask = do
  xn <- rms@input_layernorm x
  a <- scope@self_attn do
    q <- NN.linear@q_proj xn dim=QD bias=false |> reshape_heads heads=NUM_HEADS |> head_rms@q_norm
    k <- NN.linear@k_proj xn dim=KVD bias=false |> reshape_heads heads=KVH |> head_rms@k_norm
    v <- NN.linear@v_proj xn dim=KVD bias=false |> reshape_heads heads=KVH
    q, k <- rope_pair_base_factors q k rope_sin rope_cos
    k <- Tensor.repeat k repeats=(NUM_HEADS / KVH)
    v <- Tensor.repeat v repeats=(NUM_HEADS / KVH)
    return attention q k v mask |> merge_heads |> NN.linear@o_proj dim=MODEL_DIM bias=false
  x <- x + a
  xn <- rms@post_attention_layernorm x
  m <- scope@mlp do
    g <- NN.linear@gate_proj xn dim=FFN
    u <- NN.linear@up_proj xn dim=FFN
    return g |> silu |> mul u |> NN.linear@down_proj dim=MODEL_DIM
  return x + m

mean_all :: Tensor[B,S,D] -> Tensor[B,D]
mean_all h = do
  s <- Tensor.sum h dim=1 keepdim=false
  return div s S

mean_masked :: Tensor[B,S,D] -> Tensor[B,S] -> Tensor[B,D]
mean_masked h m = do
  mf <- Tensor.cast m dtype="float32" |> Tensor.unsqueeze -1
  s <- Tensor.sum (h * mf) dim=1 keepdim=false
  n <- Tensor.sum mf dim=1 keepdim=false
  return div s n

pplx_embed :: TokenIds[B,S] -> ?Mask[B,S,S] -> Tensor[B,D]
pplx_embed input_ids attn_mask = do
  attn_mask <- mask_for_input input_ids attn_mask S
  pos_ids <- position_ids input_ids
  rope_sin, rope_cos <- ((rope_base_factors pos_ids HEAD_DIM THETA) :: (Tensor[B,1,S,HEAD_DIM], Tensor[B,1,S,HEAD_DIM]))
  mask <- bidirectional_mask_for_input input_ids S padding_mask=attn_mask
  x <- NN.embedding@embed_tokens input_ids dim=MODEL_DIM
  x <- for@layers i <- [0..NUM_LAYERS) carry (x) do
    x <- pplx_block x rope_sin rope_cos mask
    yield x
  x <- rms@norm x
  h <- Tensor.cast x dtype="float32"
  -- sentence-transformers Pooling(mean): sum(h * mask) / sum(mask)
  embedding <- (attn_mask == null) ? (mean_all h) : (mean_masked h attn_mask)
  return embedding
