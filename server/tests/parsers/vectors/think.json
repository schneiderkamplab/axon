        ["reasoning_delta", "wait"]
      ]
    },
    {
      "name": "second-close-in-content-stripped",
      "chunks": ["\u003cthink\u003ethink", "\u003c/think\u003e", "ans ", "\u003c/think\u003e", "more"],
      "events": [
