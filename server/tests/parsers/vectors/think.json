        ["content_delta", "more"]
      ]
    },
    {
      "name": "unicode-reasoning",
      "chunks": ["\u003cthink\u003e", "æøå ", "\u003c/think\u003e", "svar"],
      "events": [
        ["reasoning_delta", "æøå "],
        ["content_delta", "svar"]
      ]
    },
    {
      "name": "holdback-flush-at-eos",
      "chunks": ["\u003cthink\u003eabc\u003cthin"],
